{
  "name": "@quaqduc/agent-company",
  "version": "0.2.0",
  "description": "An AI team (Manager, Researcher, Developer, Critic, and more on demand) working in a 2D pixel office. Bring any OpenAI-, Anthropic- or Gemini-compatible API.",
  "keywords": ["ai", "agents", "multi-agent", "llm", "pixel-art", "pi"],
  "license": "MIT",
  "author": "Quang Duc",
  "homepage": "https://github.com/quaqducc/agent-office#readme",
  "repository": { "type": "git", "url": "git+https://github.com/quaqducc/agent-office.git" },
  "bugs": { "url": "https://github.com/quaqducc/agent-office/issues" },
  "type": "module",
  "bin": { "agent-company": "bin/agent-company.js" },
  "files": ["bin", "dist", "ui", "library", "catalog/index.json", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md", "CHANGELOG.md"],
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "tsc --noEmit",
    "start": "node src/main.ts start",
    "catalog": "node scripts/build-catalog.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.4",
    "@earendil-works/pi-agent-core": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-codemode": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-mcp": "1.0.4",
    "@earendil-works/pi-telemetry": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "marked": "18.0.11",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
